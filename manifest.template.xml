<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>0a316d2c-0556-4628-9bb3-bdc1d4735cba</Id>
  <Version>{{MANIFEST_VERSION}}</Version>
  <ProviderName>Roth France</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="RDV &amp; Notes" />
  <Description DefaultValue="Version {{APP_VERSION}} — Suivi Dynamics, Qualification, Concernant et notes manuelles pour les rendez-vous simples ou récurrents." />
  <IconUrl DefaultValue="{{APP_URL}}/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="{{APP_URL}}/assets/icon-80.png" />
  <SupportUrl DefaultValue="{{APP_URL}}" />

  <AppDomains>
    <AppDomain>{{APP_ORIGIN}}</AppDomain>
    <AppDomain>{{DATAVERSE_URL}}</AppDomain>
    <AppDomain>https://cr-api.roth-france.fr</AppDomain>
  </AppDomains>

  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.3" /></Sets></Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{APP_URL}}/index.html?v={{APP_VERSION}}" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read" />
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Description resid="Description" />
      <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="Mailbox" /></bt:Sets></Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url" />
            <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="RfrCrmNotes.DesktopGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="RfrCrmNotes.DesktopButton">
                    <Label resid="ButtonLabel" />
                    <Supertip><Title resid="ButtonTitle" /><Description resid="ButtonDescription" /></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16" />
                      <bt:Image size="32" resid="Icon32" />
                      <bt:Image size="80" resid="Icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="RfrCrmNotes.OrganizerGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="RfrCrmNotes.OrganizerButton">
                    <Label resid="ButtonLabel" />
                    <Supertip><Title resid="ButtonTitle" /><Description resid="ButtonDescription" /></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16" />
                      <bt:Image size="32" resid="Icon32" />
                      <bt:Image size="80" resid="Icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <MobileFormFactor>
            <ExtensionPoint xsi:type="MobileLogEventAppointmentAttendee">
              <Control xsi:type="MobileButton" id="RfrCrmNotes.MobileButton">
                <Label resid="ButtonLabel" />
                <Icon>
                  <bt:Image size="25" scale="1" resid="Icon25" />
                  <bt:Image size="25" scale="2" resid="Icon25" />
                  <bt:Image size="25" scale="3" resid="Icon25" />
                  <bt:Image size="32" scale="1" resid="Icon32" />
                  <bt:Image size="32" scale="2" resid="Icon32" />
                  <bt:Image size="32" scale="3" resid="Icon32" />
                  <bt:Image size="48" scale="1" resid="Icon48" />
                  <bt:Image size="48" scale="2" resid="Icon48" />
                  <bt:Image size="48" scale="3" resid="Icon48" />
                </Icon>
                <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action>
              </Control>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="{{APP_URL}}/assets/icon-16.png" />
          <bt:Image id="Icon25" DefaultValue="{{APP_URL}}/assets/icon-25.png" />
          <bt:Image id="Icon32" DefaultValue="{{APP_URL}}/assets/icon-32.png" />
          <bt:Image id="Icon48" DefaultValue="{{APP_URL}}/assets/icon-48.png" />
          <bt:Image id="Icon80" DefaultValue="{{APP_URL}}/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="{{APP_URL}}/index.html?v={{APP_VERSION}}" /></bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Description" DefaultValue="Ajoute et consulte les notes du rendez-vous Dynamics 365." />
          <bt:String id="GroupLabel" DefaultValue="RDV &amp; Notes" />
          <bt:String id="ButtonLabel" DefaultValue="RDV &amp; Notes" />
          <bt:String id="ButtonTitle" DefaultValue="RDV &amp; Notes" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonDescription" DefaultValue="Modifier le Concernant et la Qualification, suivre le RDV dans Dynamics ou ajouter une note simple." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
