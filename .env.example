# Identifiants publics de l'inscription d'application Microsoft Entra.
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000

# URL racine de l'environnement Dataverse, sans /api/data/v9.2.
# Production Roth France : https://roth.crm4.dynamics.com
VITE_DATAVERSE_URL=https://YOURORG.crm4.dynamics.com

# URL HTTPS où le contenu du dossier dist sera publié, sans barre finale.
# Exemple : https://rfr-note-crm.azurestaticapps.net
APP_URL=https://YOUR-HOST.example
